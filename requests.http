@host = http://localhost:3000

### ===== Рівень 1–2: CRUD =====

### Створити пристрій 1
# @name create1
POST {{host}}/gadgets
Content-Type: application/json

{
  "title": "Ноутбук Pro 16",
  "price": 45000,
  "warrantyMonths": 24,
  "cpu": "M3 Max",
  "ramGb": 36
}

###
@id = {{create1.response.body.id}}

